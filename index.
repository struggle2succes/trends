function render(){
 const q=search.value.trim().toLowerCase();
 const shown=products.filter(p=>(active==="Alles"||p.category===active) && (p.title.toLowerCase().includes(q)||p.category.toLowerCase().includes(q)));
 document.getElementById("count").textContent=`${shown.length} products found`;
 grid.innerHTML="";
 if(!shown.length){grid.innerHTML='<div class="no-results">No products found. Try another search term.</div>';return;}
 shown.forEach((p,i)=>{
   const imgs=gallery[p.number]||[];
   const pal=palettes[(p.number+i)%palettes.length];
   const card=document.createElement("article"); card.className="card";
   const photo=imgs.length?`<img class="product-photo" src="${imgs[0]}" alt="${escapeHTML(p.title)}" loading="lazy">`:`<div class="art" style="background:linear-gradient(135deg,${pal[0]},${pal[1]})"><span class="spark">✦</span><span class="icon">${p.icon}</span></div>`;
   const thumbs=imgs.length?`<div class="thumbstrip">${imgs.map((src,j)=>`<img src="${src}" alt="Photo ${j+1}" data-index="${j}" class="${j===0?'active':''}" loading="lazy">`).join("")}</div>`:"";
   card.innerHTML=`${photo}${thumbs}<div class="card-body"><span class="category">Product ${p.number} · ${p.category}</span><h3>${escapeHTML(p.title)}</h3><p class="description">${escapeHTML(p.description)}</p><a class="buy" href="${p.url}" target="_blank" rel="sponsored nofollow noopener noreferrer">View Product ↗</a></div>`;
   if(imgs.length){
     const main=card.querySelector(".product-photo");
     card.querySelectorAll(".thumbstrip img").forEach((thumb)=>thumb.addEventListener("click",()=>{main.src=thumb.src;card.querySelectorAll(".thumbstrip img").forEach(t=>t.classList.remove("active"));thumb.classList.add("active");}));
     main.addEventListener("click",()=>{let cur=imgs.indexOf(main.getAttribute("src"));let next=(cur+1)%imgs.length;main.src=imgs[next];card.querySelectorAll(".thumbstrip img").forEach((t,j)=>t.classList.toggle("active",j===next));});
   }
   grid.appendChild(card);
 });
}
function escapeHTML(s){return s.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
